import { check, fail } from 'k6';
import http from 'k6/http';
import { scenario } from 'k6/execution';
import { Trend, Counter, Rate } from 'k6/metrics';
import { textSummary } from 'https://jslib.k6.io/k6-summary/0.0.2/index.js';

const host = "{{ host }}";
const apiKey = __ENV.HF_TOKEN;
const dataset = JSON.parse(open("{{ data_file }}"));
const filePath = "{{ out_dir }}/summary.json";

// Metrics definition
const responseLatency = new Trend('response_latency', true);
const requestThroughput = new Counter('request_throughput');
const classificationAccuracy = new Counter('classification_accuracy');
const totalRequests = new Trend('total_requests', true);
const accuracyCount = new Trend('accuracy_count', true);
const accuracyPercentage = new Trend('accuracy_percentage', true);
const tokensPerSecond = new Trend('tokens_per_second', true);

export function handleSummary(data) {
    return {
        stdout: JSON.stringify(data, null, 2), // Pretty-print JSON
    };
}

export function generatePayload(example) {
    return {
        "input": [example.text],
    };
}

export const options = get_options();

export default function run() {
    const headers = {
        Accept: "application/json",
        Authorization: "Bearer " + apiKey,
        "Content-Type": "application/json",
    };
    const query = dataset[scenario.iterationInTest % dataset.length];
    const payload = JSON.stringify(generatePayload(query));
    const url = `${host}/classify`;
    const params = {
        method: 'POST',
        body: payload,
        headers,
    };

    // Sending the request
    const startTime = Date.now();
    const res = http.post(url, payload, params);
    const endTime = Date.now();
    const deltaMs = endTime - startTime; // Duration in milliseconds

    // Add response latency
    responseLatency.add(deltaMs);
    requestThroughput.add(1);

    // Check the response
    const passedCheck = check(res, {
        'http_200': (r) => r.status === 200,
    });

    if (!passedCheck) {
        fail('Request failed with status ' + res.status);
        return;
    }

    // Process the response
    let tokenCount = 0;
    let isCorrectClassification = false;
    try {
        const data = JSON.parse(res.body);
        if (data.object === 'classify' && data.data && data.data[0] && data.data[0].length > 0) {
            const predictedLabel = data.data[0][0].label;
            if (query.hasOwnProperty('label')) {
                if (predictedLabel === query.label) {
                    classificationAccuracy.add(1);
                    isCorrectClassification = true;
                }
            }

            // Add token count to tokens throughput
            if (data.usage && data.usage.total_tokens) {
                tokenCount = data.usage.total_tokens;
            }
        }
    } catch (e) {
        fail('Failed to parse response body: ' + e);
    }

    // Calculate and add tokens per second if token count is available
    if (tokenCount > 0) {
        const tokensPerSec = tokenCount / (deltaMs / 1000); // Tokens per second
        tokensPerSecond.add(tokensPerSec);
    }

    // Update custom accuracy metrics
    const correctCount = classificationAccuracy.count;
    const totalCount = requestThroughput.count;
    const accuracyPct = totalCount > 0 ? (correctCount / totalCount) * 100 : 0;

    // Add custom metrics
    totalRequests.add(totalCount);
    accuracyCount.add(correctCount);
    accuracyPercentage.add(accuracyPct);
}